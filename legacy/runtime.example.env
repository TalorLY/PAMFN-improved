# Edit GPU_LIST here, or export GPU_LIST before starting. Physical GPU indexes.
export GPU_LIST="${GPU_LIST:-4}"
# Reuse the external environment already used by v37; do not reinstall pamfn_ly.
export V38_PYTHON="${V38_PYTHON:-/szztdata/ly/exp0_source/v33_runtime/pamfn_ext_v33/bin/python}"
export V38_SOURCE_ROOT="${V38_SOURCE_ROOT:-/szztdata/ly/exp0_source/PAMFN-v17-fs1000-v37/results/v17_fs1000_v37}"
export V38_DATA="${V38_DATA:-/szztdata/ly/exp0_source/shared_data/FS1000}"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export CUBLAS_WORKSPACE_CONFIG=:4096:8

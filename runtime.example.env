# Existing external environment; do not install or modify pamfn_ly.
export V39_PYTHON="/szztdata/ly/exp0_source/v33_runtime/pamfn_ext_v33/bin/python"
export V39_SOURCE_ROOT="/szztdata/ly/exp0_source/PAMFN-v17-transfer-v38/results/v17_transfer_v38"
export V39_DATA="/szztdata/ly/exp0_source/shared_data/FS1000"
# Physical GPU ids, e.g. "0 4". Training: one cell per selected GPU.
export GPU_LIST="4"
# auto chooses one of GPU_LIST for serial timing AFTER training.
export BENCH_GPU="auto"
# 0: allow diagnostic shared-GPU timing; 1: fail if another compute PID is seen.
export BENCH_REQUIRE_EXCLUSIVE="0"
export PYTHONNOUSERSITE="1"
export PYTHONDONTWRITEBYTECODE="1"
